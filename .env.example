
# Application
APP_NAME=araya-business-hub
APP_ENV=development
APP_PORT=8080

# PostgreSQL Database 
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_NAME=postgres
DB_SSLMODE=require
DATABASE_URL="postgresql://postgres.your_project_ref:your_database_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Authentication / JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Logging
LOG_LEVEL=debug
