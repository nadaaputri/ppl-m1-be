
# Application
APP_NAME=araya-business-hub
APP_ENV=development
APP_PORT=8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=araya_business_hub
DB_SSLMODE=disable

# Authentication / JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=debug
